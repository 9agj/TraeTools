<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TraeTools.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="TraeTools.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 账号概览卡片：预占 1.5 边框高度，当前激活账号用高亮粗边框框出 -->
        <Style Selector="Border.acct-card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.acct-card.acct-active">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#1A3B82F6" />
        </Style>
        <!-- 账号概览按钮：透明无阴影，悬停时铺满整张卡片（与外框圆角一致） -->
        <Style Selector="Button.acct-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.acct-card /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.acct-card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#103B82F6" />
        </Style>
        <Style Selector="Button.acct-card:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A3B82F6" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">

            <!-- ===== Header ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="仪表盘" Classes="page-title" />
                    <TextBlock Text="{Binding DateText}" Classes="page-subtitle" />
                    <!-- 当前账号：头像是与"账号管理"一致的真实头像，否则显示首字母兜底 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"
                                IsVisible="{Binding HasCurrentAccount}">
                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                            <Border CornerRadius="20" Background="{Binding CurrentAccountInfo.Color}"
                                    IsVisible="{Binding !CurrentAccountInfo.HasAvatar}">
                                <TextBlock Text="{Binding CurrentAccountInfo.Initial}" Foreground="White"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Rectangle RadiusX="20" RadiusY="20" IsVisible="{Binding CurrentAccountInfo.HasAvatar}">
                                <Rectangle.Fill>
                                    <ImageBrush Source="{Binding CurrentAccountInfo.AvatarImage}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding CurrentAccountInfo.Name}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="当前账号" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="btn" Content="刷新状态" Command="{Binding RefreshStatusCommand}" />
                    <Button Classes="btn-danger" Content="重新登录" Command="{Binding ReloginCommand}"
                        IsVisible="{Binding NeedLogin}" />
                    <Button Classes="btn-primary" Content="立即签到" Command="{Binding QuickCheckinCommand}"
                            IsEnabled="{Binding CanQuickCheckin}" />
                </StackPanel>
            </Grid>

            <!-- ===== 3 Stat Cards ===== -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="剩余积分" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding RemainingCredits}" Classes="card-value" />
                            <TextBlock Text="分" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Margin="10,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="今日签到" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding CheckinStatus}" Classes="card-value" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Margin="10,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="连续签到" Classes="card-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding StreakDays}" Classes="card-value" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="天" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Trend Chart + Account Overview ===== -->
            <Grid ColumnDefinitions="1.6*,1*">
                <!-- Trend Chart -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="近 14 天积分趋势" Classes="card-title" />
                            <Border Grid.Column="1" Classes="badge-info">
                                <TextBlock Text="{Binding TodayReward}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </Grid>
                        <Grid RowDefinitions="200,Auto">
                            <!-- Row 0: Y 轴刻度 + Chart Canvas -->
                            <Grid Grid.Row="0" ColumnDefinitions="40,*">
                                <!-- Y 轴积分刻度（上=最大值，中=中值，下=最小值） -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
                                    <TextBlock Grid.Row="0" Text="{Binding ChartYMax}" FontSize="10" Foreground="{StaticResource TextSubBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="1" Text="{Binding ChartYMid}" FontSize="10" Foreground="{StaticResource TextSubBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="{Binding ChartYMin}" FontSize="10" Foreground="{StaticResource TextSubBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                </Grid>
                                <Viewbox Grid.Column="1" Stretch="Fill" Height="200" HorizontalAlignment="Stretch" ClipToBounds="False">
                            <Canvas Width="520" Height="200" Background="Transparent" ClipToBounds="False">
                                <!-- Grid lines -->
                                <Line StartPoint="0,40" EndPoint="520,40" Stroke="#FFE2E8F0" StrokeThickness="1" />
                                <Line StartPoint="0,100" EndPoint="520,100" Stroke="#FFE2E8F0" StrokeThickness="1" />
                                <Line StartPoint="0,160" EndPoint="520,160" Stroke="#FFE2E8F0" StrokeThickness="1" />
                                <!-- Fill area -->
                                <Path Data="{Binding FillGeometry}">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                            <GradientStop Color="#663B82F6" Offset="0" />
                                            <GradientStop Color="#0A3B82F6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <!-- Line -->
                                <Polyline Points="{Binding LinePoints}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" StrokeJoin="Round" />
                                <!-- Today marker -->
                                <Ellipse Canvas.Left="{Binding TodayX}" Canvas.Top="{Binding TodayY}" Width="12" Height="12" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" />
                                <!-- Hover hit areas: contiguous coverage（宽度=步长，无缝隙，即时触发） -->
                                <ItemsControl ItemsSource="{Binding TrendPoints}" x:CompileBindings="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="520" Height="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerTheme>
                                        <ControlTheme TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        </ControlTheme>
                                    </ItemsControl.ItemContainerTheme>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding StepWidth}" Height="200" Background="Transparent"
                                                    PointerEntered="TrendHoverEnter" PointerExited="TrendHoverExit">
                                                <Canvas>
                                                    <!-- 每个数据点一个可见圆点标记（相对 hit-area 原点居中，横坐标由外层 Canvas.Left 定位） -->
                                                    <Ellipse Canvas.Left="0" Canvas.Top="{Binding Y}" Width="12" Height="12"
                                                             Margin="-6,-6,0,0" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" />
                                                    <!-- 命中该点时竖直参考线 -->
                                                    <Border Width="1" Height="200" Background="#223B82F6" IsVisible="{Binding IsHovered}" HorizontalAlignment="Center" />
                                                </Canvas>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- 即时悬浮冒泡：显示命中日期与积分 -->
                                <Border IsVisible="{Binding TrendHoverVisible}" Background="#FF1E293B" CornerRadius="6"
                                        Padding="10,6" IsHitTestVisible="False"
                                        Canvas.Left="{Binding TrendHover.X}" Canvas.Top="{Binding TrendHover.Y}" Margin="-40,-44,0,0">
                                    <TextBlock Text="{Binding TrendHover.Tooltip}" FontSize="12" Foreground="White" TextAlignment="Center" />
                                </Border>
                                </Canvas>
                                </Viewbox>
                            </Grid>
                            <!-- Row 1: X axis date labels -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding XAxisLabels}" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Account Overview -->
                <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="账号概览" Classes="card-title" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="acct-card" Classes.acct-active="{Binding IsCurrent}" Margin="0,2">
                                        <Button Classes="acct-card" Command="{Binding SelectCommand}" Background="Transparent" Padding="0"
                                                HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="36,*,Auto" Margin="6,4">
                                                <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                                    <Border CornerRadius="18" Background="{Binding Color}" IsVisible="{Binding !HasAvatar}">
                                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Rectangle RadiusX="18" RadiusY="18" IsVisible="{Binding HasAvatar}">
                                                        <Rectangle.Fill>
                                                            <ImageBrush Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                                                <Border Grid.Column="2" Classes.badge-ok="{Binding IsCurrent}" Classes.badge-info="{Binding !IsCurrent}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>





